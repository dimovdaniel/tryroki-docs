{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Roki",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "wordpress",
          "lovable"
        ]
      },
      {
        "group": "Webhooks",
        "pages": [
          "webhooks/overview",
          "webhooks/zapier",
          "webhooks/make",
          "webhooks/pabbly"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://tryroki.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tryroki.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://tryroki.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/tryroki",
      "github": "https://github.com/dimovdaniel/tryroki-docs"
    }
  }
}
